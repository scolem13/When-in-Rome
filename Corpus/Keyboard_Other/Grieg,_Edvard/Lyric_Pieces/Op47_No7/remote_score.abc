"m" (!>!B2 F>B |"m" !>!^A2 F2 |"m" !>!!courtesy!=A2 F>A |"m" !>!^G4) |"" !>!!courtesy!=G2 D>G | %5
"" !>!F2 D2 |"m" !>!^E2 D>E |"m""" !>!C4 |$[K:bass]"m" (!>![B,,B,]2 [F,,F,]>[B,,B,] | %9
"m" !>![^A,,^A,]2 [F,,F,]2 |"m" !>![!courtesy!=A,,!courtesy!=A,]2 [F,,F,]>[A,,A,] | %11
"m" !>![^G,,^G,]4) |"" (!>![!courtesy!=G,,!courtesy!=G,]2 [D,,D,]>[G,,G,] | %13
"" !>![F,,F,]2 [D,,D,]2 |"m" !>![^E,,^E,]2 [D,,D,]>[E,,E,] |"m" !>![C,,C,]2"" [F,,,F,,]2) | %16
[K:treble]"m" z (^A"m"=A"m"^G) |$"m" z (^G""=G""F) |"m" z (^A"m"=A"m"^G) |"m" z (^G""=G""F) | %20
"m" z (^B"m"=B"m"^A) |"m" z (^A""=A""^G) |$"m" z (^B"m"=B"m"^A) |"m" z (^A""=A""^G) | %24
"m" z (^^c"m"^c"m"^B) |"m" z (^B""=B""^A) |"m" z (^B""=B""^A) |$"m" z (^B""=B""^A) | %28
