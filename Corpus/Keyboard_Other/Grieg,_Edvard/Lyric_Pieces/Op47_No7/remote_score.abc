""!ped! z ([F,,,F,,]!courtesy!^C,E, | ^A,CE^A) | z2 (!>!!courtesy!=a2- | a2!>(! g2 |$ %36
 f^e!>)!c!ped-up!e | !courtesy!=e=c!fermata!e^d) |"m"!p! (!>!B2 F>B |"m" !>!^A2 F2 |$ %40
"m" !>!!courtesy!=A2 F>A |"m" !>!^G4) |"" !>!!courtesy!=G2 D>G |"" !>!F2 D2 |"m" !>!^E2 D>E | %45
"m""" !>!C4 |[K:bass]"m" (!>![B,,B,]2 [F,,F,]>[B,,B,] |"m" !>![^A,,^A,]2 [F,,F,]2 | %48
"m" !>![!courtesy!=A,,!courtesy!=A,]2 [F,,F,]>[A,,A,] |$"m" !>![^G,,^G,]4) | %50
"" (!>![!courtesy!=G,,!courtesy!=G,]2 [D,,D,]>[G,,G,] |"" !>![F,,F,]2 [D,,D,]2 | %52
"m" !>![^E,,^E,]2 [D,,D,]>[E,,E,] |"m" ((!>![C,,C,]2)"" [F,,,F,,]2-)) | [F,,,F,,]4 | %55
[K:treble]"m" z (^A"m"=A"m"^G) |"m" z (^G""=G""F) |$"m" z (^A"m"=A"m"^G) |"m" z (^G""=G""F) | %59
"m" z (^B"m"=B"m"^A) |"m" z (^A""=A""^G) |"m" z (^B"m"=B"m"^A) |$"m" z (^A""=A""^G) | %63
"m" z (^^c"m"^c"m"^B) |$"m" z (^B""=B""^A) |"m" z (^B""=B""^A) |"m" z (^B""=B""^A) | %67
[K:bass]"" z (!courtesy!^C,^G,B, |!<(! ^E^GB^e)!<)! |"" z (=C,!courtesy!=G,^A, |$ %70
 !courtesy!=EG^Ae) |$""!ped! z ([F,,,F,,]"^rit."!courtesy!^C,E, | ^A,C)E^A | %73
 z2 (!>!!courtesy!=a2- | a2!>(! g2 | f!>)!^ec!ped-up!e | !courtesy!=e=c!fermata!e^d) | %77
"m" (!>!B2 F>B |"m" !>!^A2 F2 |"m" !>!!courtesy!=A2 F>A |$"m" !>!^G4) |"" !>!!courtesy!=G2 D>G | %82
"" !>!F2 D2 |"m" !>!^E2 D>E |"m""" !>!C4 |[K:bass]"m" (!>![B,,B,]2 [F,,F,]>[B,,B,] | %86
"m" !>![^A,,^A,]2 [F,,F,]2 |"m" !>![!courtesy!=A,,!courtesy!=A,]2 [F,,F,]>[A,,A,] |$ %88
"m" !>![^G,,^G,]4) |"" (!>![!courtesy!=G,,!courtesy!=G,]2 [D,,D,]>[G,,G,] | %90
"" !>![F,,F,]2 [D,,D,]2 |"m" !>![^E,,^E,]2 [D,,D,]>[E,,E,] |"m" ((!>![C,,C,]2)"" [F,,,F,,]2-)) | %93
 [F,,,F,,]4 |"m""^morendo" ((!>![F,,,F,,]2"m"!ped! [B,,,,B,,,]2-)) | [B,,,,B,,,]4 | %96
 !fermata![B,DFB]4!ped-up! |] %97
